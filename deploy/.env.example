# Must match the tag passed as IMAGE_TAG when building the image bundle.
IMAGE_TAG='0.1.0'

# Public HTTP listener. Use 127.0.0.1 when another reverse proxy terminates HTTPS.
HTTP_BIND_ADDRESS='0.0.0.0'
HTTP_PORT='18000'
TZ='Asia/Shanghai'

# Existing host media directory. It is mounted read-write into the backend.
MEDIA_DATA_DIR='/data/acg17'

# MySQL. Generate independent, high-strength production passwords.
MYSQL_ROOT_PASSWORD='replace-with-a-strong-root-password'
DB_USERNAME='acg17'
DB_PASSWORD='replace-with-a-strong-database-password'
DB_URL='jdbc:mysql://mysql:3306/acg17?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai'

# SMTP credentials.
MAIL_HOST='smtp.qq.com'
MAIL_PORT='587'
MAIL_USERNAME='replace-with-your-mail-account'
MAIL_PASSWORD='replace-with-your-smtp-credential'

# Generate these separately with: openssl rand -hex 32
JWT_SECRET='replace-with-at-least-32-random-bytes'
JWT_EXPIRATION_HOURS='24'
MEDIA_URL_SECRET='replace-with-another-32-random-bytes'
MEDIA_URL_EXPIRATION_MINUTES='60'

LOGIN_MAX_ATTEMPTS='10'
LOGIN_WINDOW_MINUTES='5'

# Java reads this variable automatically. Adjust the RAM percentage if required.
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai'
