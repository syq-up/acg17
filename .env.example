# Docker Compose 初始化 MySQL 时使用；请设置高强度 root 密码。
MYSQL_ROOT_PASSWORD='replace-with-a-strong-root-password'

# 后端数据库连接。开发环境默认连接本机 Compose MySQL。
DB_URL='jdbc:mysql://127.0.0.1:3306/acg17?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai'
DB_USERNAME='acg17'
DB_PASSWORD='replace-with-a-strong-database-password'

# SMTP 配置；MAIL_PASSWORD 应使用邮件服务商提供的 SMTP 授权凭据。
MAIL_HOST='smtp.qq.com'
MAIL_PORT='587'
MAIL_USERNAME='replace-with-your-mail-account'
MAIL_PASSWORD='replace-with-your-smtp-credential'

# 两个签名密钥必须彼此独立，并且都至少包含 32 字节随机数据。
JWT_SECRET='replace-with-at-least-32-random-bytes'
JWT_EXPIRATION_HOURS='24'
MEDIA_URL_SECRET='replace-with-another-32-random-bytes'
MEDIA_URL_EXPIRATION_MINUTES='60'

LOGIN_MAX_ATTEMPTS='10'
LOGIN_WINDOW_MINUTES='5'
