<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shiyq.mapper.MangaTagRelationMapper">

    <insert id="insertRelation">
        INSERT INTO `manga_tag_relation` (`manga_id`, `tag_id`, `user_id`)
        VALUES (#{mangaId}, #{tagId}, #{userId}) AS new
        ON DUPLICATE KEY UPDATE `tag_id` = new.`tag_id`
    </insert>

    <delete id="deleteRelation">
        DELETE FROM `manga_tag_relation`
        WHERE `manga_id` = #{mangaId}
          AND `tag_id` = #{tagId}
          AND `user_id` = #{userId}
    </delete>

    <select id="countByTagId" resultType="long">
        SELECT COUNT(*)
        FROM `manga_tag_relation`
        WHERE `tag_id` = #{tagId} AND `user_id` = #{userId}
    </select>

</mapper>
